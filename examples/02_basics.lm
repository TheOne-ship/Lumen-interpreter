# Variables, data types, operators and control flow

let age = 20;
let height = 1.75;
let student = "Ravi";
let enrolled = true;
let nothing = nil;

print("--- Data types ---");
print(student, "is", type(student));
print(age, "is", type(age));
print(height, "is", type(height));
print(enrolled, "is", type(enrolled));
print(nothing, "is", type(nothing));

print("--- Arithmetic ---");
print("17 + 5  =", 17 + 5);
print("17 - 5  =", 17 - 5);
print("17 * 5  =", 17 * 5);
print("17 / 5  =", 17 / 5);
print("17 % 5  =", 17 % 5);
print("(2 + 3) * 4 =", (2 + 3) * 4);

print("--- Strings ---");
let greeting = "Hello" + ", " + student;
print(greeting);
print("Length:", len(greeting));
print("First letter:", greeting[0], " Last letter:", greeting[-1]);
print("=" * 20);

print("--- If / else ---");
if (age >= 18 and enrolled) {
    print(student, "is an adult student");
} else {
    print(student, "is not an adult student");
}

print("--- FizzBuzz (1 to 15) ---");
for (i in range(1, 16)) {
    if (i % 15 == 0) {
        print("FizzBuzz");
    } else if (i % 3 == 0) {
        print("Fizz");
    } else if (i % 5 == 0) {
        print("Buzz");
    } else {
        print(i);
    }
}

print("--- While loop: countdown ---");
let n = 5;
while (n > 0) {
    print(n);
    n = n - 1;
}
print("Liftoff!");
