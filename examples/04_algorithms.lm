# Classic algorithms implemented in Lumen

# --- Bubble sort ---
fn bubble_sort(arr) {
    let n = len(arr);
    for (i in range(n)) {
        let swapped = false;
        for (j in range(0, n - i - 1)) {
            if (arr[j] > arr[j + 1]) {
                let tmp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
                swapped = true;
            }
        }
        if (not swapped) { break; }
    }
    return arr;
}

# --- Binary search (list must be sorted) ---
fn binary_search(arr, target) {
    let low = 0;
    let high = len(arr) - 1;
    while (low <= high) {
        let mid = int((low + high) / 2);
        if (arr[mid] == target) { return mid; }
        if (arr[mid] < target) { low = mid + 1; } else { high = mid - 1; }
    }
    return -1;
}

# --- Sieve of Eratosthenes ---
fn primes_up_to(limit) {
    let is_prime = [true] * (limit + 1);
    is_prime[0] = false;
    is_prime[1] = false;
    let p = 2;
    while (p * p <= limit) {
        if (is_prime[p]) {
            let m = p * p;
            while (m <= limit) {
                is_prime[m] = false;
                m = m + p;
            }
        }
        p = p + 1;
    }
    let result = [];
    for (i in range(limit + 1)) {
        if (is_prime[i]) { push(result, i); }
    }
    return result;
}

# --- GCD (Euclid) ---
fn gcd(a, b) {
    while (b != 0) {
        let t = b;
        b = a % b;
        a = t;
    }
    return a;
}

# --- Palindrome check ---
fn is_palindrome(word) {
    let i = 0;
    let j = len(word) - 1;
    while (i < j) {
        if (word[i] != word[j]) { return false; }
        i = i + 1;
        j = j - 1;
    }
    return true;
}

let data = [64, 34, 25, 12, 22, 11, 90, 5];
print("Original list:", data);
let sorted = bubble_sort(data);
print("Sorted list:  ", sorted);
print("Index of 25:  ", binary_search(sorted, 25));
print("Index of 99:  ", binary_search(sorted, 99));
print("Primes <= 50: ", primes_up_to(50));
print("gcd(84, 36) = ", gcd(84, 36));
for (w in ["level", "lumen", "racecar"]) {
    print(w, "is palindrome?", is_palindrome(w));
}

# --- Timing ---
let start = clock();
let f = 0;
for (i in range(20000)) { f = f + i; }
print("Summed 20000 numbers in", int((clock() - start) * 1000), "ms");
